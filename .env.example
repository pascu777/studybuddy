# Copia questo file in `.env` e compila i valori del tuo progetto Supabase.
# Le variabili con prefisso EXPO_PUBLIC_ sono incluse nel bundle (client-side).

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# In sviluppo: "true" per saltare la schermata "conferma la mail" dopo la
# registrazione (richiede anche di disattivare la conferma email su Supabase,
# oppure l'uso di Supabase locale). In produzione lasciare a "false".
EXPO_PUBLIC_SKIP_EMAIL_CONFIRMATION=false
