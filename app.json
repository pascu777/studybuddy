{
  "expo": {
    "name": "StudyBuddy",
    "slug": "studybuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studybuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studybuddy.app"
    },
    "android": {
      "package": "com.studybuddy.app",
      "adaptiveIcon": {
        "backgroundColor": "#6B4EFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6B4EFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "StudyBuddy usa la tua posizione per trovare tutor vicino a te (entro ~20–30 km)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StudyBuddy accede alle tue foto per impostare l'immagine del profilo."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6B4EFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
